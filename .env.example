# Database
DATABASE_URL="mysql://user:password@localhost:3306/lychee"

# JWT Secret for session management (generate with: openssl rand -base64 32)
JWT_SECRET="<your_random_jwt_secret>"

# Email/password auth — set these to create your admin account on first boot
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="your-password"

# LLM for note classification — set one (Gemini preferred, same model as Manus Forge)
# Get a free Gemini API key at https://aistudio.google.com
GEMINI_API_KEY="AIza..."
# Or use OpenAI instead (uses gpt-4o-mini)
# OPENAI_API_KEY="sk-..."

# --- Manus platform (optional — only needed when running inside Manus) ---
VITE_APP_ID="<your_app_id>"
OAUTH_SERVER_URL="https://manus.computer"
VITE_OAUTH_PORTAL_URL="https://manus.computer"
OWNER_OPEN_ID="<your_manus_openid>"
BUILT_IN_FORGE_API_URL="https://forge.manus.im"
BUILT_IN_FORGE_API_KEY="<your_forge_api_key>"
